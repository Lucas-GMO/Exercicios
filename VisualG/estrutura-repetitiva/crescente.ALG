Algoritmo "semnome"

Var

   x, y : inteiro

Inicio

   escreva("Digite dois números: ")
   leia(x)
   leia(y)

   enquanto (x <> y) faca
   
      se (x < y) entao
         escreval("CRESCENTE")
      senao
          escreval("DECRESCENTE")
      fimse
      
      escreva("Digite dois números: ")
      leia(x)
      leia(y)
      
   fimenquanto

   
   escreval("Números iguais")
   
   
Fimalgoritmo