Algoritmo "semnome"

Var

  senha, tentativa : inteiro

Inicio

   senha <- 2020
    
   escreval("Digite a senha: ")
   leia(tentativa)
   
   enquanto (tentativa <> senha) faca
      escreval("Senha Inválida! Tente novamente: ")
      leia(tentativa)
   fimenquanto
   
   escreval("Aesso Permitido!")


Fimalgoritmo