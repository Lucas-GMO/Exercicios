Algoritmo "semnome"

Var

   x, soma : inteiro

Inicio

   escreva("Digite o primeiro número: ")
   leia(x)
   
   soma <- 0
   enquanto (x <> 0) faca
      soma <- soma + x
      escreva("Digie outro número: ")
      leia(x)
   fimenquanto
   
   escreval("Soma: ", soma)

Fimalgoritmo